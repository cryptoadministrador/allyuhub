# Copia de trabajo para el droplet: cp deploy/env.production.example .env
# y rellena APP_KEY (key:generate) y DB_PASSWORD (la de deploy/.env.db).
APP_NAME=AllyuHub
APP_ENV=production
APP_DEBUG=false
APP_URL=https://allyu.cuysoft.io
APP_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=info

# El `db` es el nombre del servicio en deploy/docker-compose.yml.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=allyuhub
DB_USERNAME=allyu
DB_PASSWORD=

# La sesión tiene que sobrevivir el iframe cross-site de Moodle (piloto §3
# de docs/lti-moodle.md): None + Secure + Partitioned (CHIPS).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=none
SESSION_SECURE_COOKIE=true
SESSION_PARTITIONED_COOKIE=true

# Un solo servidor: base de datos para cache y colas basta y sobra.
# El nonce de OIDC vive en esta cache — si algún día hay 2+ workers de
# web, la cache DEBE seguir siendo compartida (regla de la auditoría LTI).
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
